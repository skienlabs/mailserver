{
  "name": "Skien Mails",
  "short_name": "Skien Mails",
  "description": "Email for your organisation",
  "id": "/",
  "start_url": "/#/inbox",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#0b57d0",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Compose", "short_name": "Compose", "url": "/#/compose", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Inbox", "short_name": "Inbox", "url": "/#/inbox", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "protocol_handlers": [
    { "protocol": "mailto", "url": "/#/compose?mailto=%s" }
  ]
}
