{
  "name": "{{PRODUCT}}",
  "short_name": "{{PRODUCT}}",
  "description": "Email for your organisation",
  "id": "/",
  "start_url": "/#/inbox",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f7f8",
  "theme_color": "#f7f7f8",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/brand/icon-192.png?c={{ICON}}", "sizes": "192x192", "type": "image/png" },
    { "src": "/brand/icon-512.png?c={{ICON}}", "sizes": "512x512", "type": "image/png" },
    { "src": "/brand/maskable-512.png?c={{ICON}}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/mark.svg?c={{ICON}}", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Compose", "short_name": "Compose", "url": "/#/compose", "icons": [{ "src": "/brand/icon-192.png?c={{ICON}}", "sizes": "192x192" }] },
    { "name": "Inbox", "short_name": "Inbox", "url": "/#/inbox", "icons": [{ "src": "/brand/icon-192.png?c={{ICON}}", "sizes": "192x192" }] }
  ],
  "protocol_handlers": [
    { "protocol": "mailto", "url": "/#/compose?mailto=%s" }
  ]
}
